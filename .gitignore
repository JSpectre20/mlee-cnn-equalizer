# --- regenerable / bulky build outputs -------------------------------------
# Vivado block-design projects (rebuilt by equalizer/rtl/bd/build_bd.tcl; the
# overlay and reports of the final build are frozen in equalizer/checkpoints/hw_v1)
equalizer/rtl/bd/proj_*/
*.dcp
*.jou
*.wdb
*.pb
*.rtd
*.dmp
.Xil/
xsim.dir/
equalizer/rtl/sim/work_*/
equalizer/rtl/**/vivado*.log
equalizer/rtl/**/hs_err_*.log
equalizer/rtl/**/webtalk*

# datasets written by experiment scripts (regenerable from the simulator with fixed seeds;
# the datasets behind the reported results are frozen in equalizer/checkpoints/fp32_v1)
equalizer/results/**/*.npz

# --- local-only -------------------------------------------------------------
backups/
__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/
.vscode/
.idea/
*.swp

# Vivado scratch files written next to the scripts
equalizer/rtl/**/dfx_runtime.txt
equalizer/rtl/**/clockInfo.txt
equalizer/rtl/**/retry_open_fs.log
equalizer/rtl/bd/NA/

# gate-level power simulation work dirs (netlists, SAIF, xsim)
equalizer/rtl/power/work_*/

# report build outputs and superseded figures
report/diagrams/build/
report/figures/unused/
~$*.docx
poster/*.log

# on-board run package: regenerable copies (scripts/make_board_vectors.py)
equalizer/board/board_vectors.npz
equalizer/board/cnn_eq.bit
equalizer/board/cnn_eq.hwh

# notes and documentation kept locally only
*.md
!/README.md

# report and poster build tooling: kept locally, the repo holds the deliverables
report/*
!report/MLEE_Report.docx
!report/MLEE_Report.pdf
poster/*.py
poster/*.drawio
poster/*.png
!poster/bits_logo.png
