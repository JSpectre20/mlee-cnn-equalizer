<mxfile host="drawio"><diagram name="pipeline" id="pipeline"><mxGraphModel dx="800" dy="600" grid="1" gridSize="5" page="0" math="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F6F9FD;strokeColor=#D9E2F3;fontColor=#1F3864;fontFamily=Arial;fontSize=9;align=center;verticalAlign=middle;strokeWidth=1;dashed=0;spacing=3;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="640" height="140" as="geometry"/></mxCell><mxCell id="c3" value="" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FDF6F1;strokeColor=#F2D3BF;fontColor=#1F3864;fontFamily=Arial;fontSize=9;align=center;verticalAlign=middle;strokeWidth=1;dashed=0;spacing=3;" vertex="1" parent="1"><mxGeometry x="0" y="158" width="640" height="158" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Algorithm and learning&lt;/b&gt;  (Python, PyTorch; package &lt;i&gt;eqsim&lt;/i&gt;)" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=10.5;fontColor=#2E75B6;align=left;verticalAlign=middle;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="10" y="4" width="600" height="18" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Hardware&lt;/b&gt;  (hand-written SystemVerilog, Vivado / xsim 2025.2, PYNQ-Z2)" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=10.5;fontColor=#C55A11;align=left;verticalAlign=middle;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="10" y="294" width="600" height="18" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;1  Channels&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.6px&quot; color=&quot;#333333&quot;&gt;40 GBd PAM2 IM/DD,&lt;br&gt;31.5 km SSMF;&lt;br&gt;Proakis-B&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E75B6;fontColor=#1F3864;fontFamily=Arial;fontSize=10;align=center;verticalAlign=middle;strokeWidth=1.2;dashed=0;spacing=3;" vertex="1" parent="1"><mxGeometry x="8.0" y="34" width="114" height="90" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;2  Baselines&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.6px&quot; color=&quot;#333333&quot;&gt;FIR, Volterra,&lt;br&gt;FFE + DFE, MLSE&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E75B6;fontColor=#1F3864;fontFamily=Arial;fontSize=10;align=center;verticalAlign=middle;strokeWidth=1.2;dashed=0;spacing=3;" vertex="1" parent="1"><mxGeometry x="139.5" y="34" width="114" height="90" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;3  CNN search&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.6px&quot; color=&quot;#333333&quot;&gt;135 topologies&lt;br&gt;&amp;times; MSE / cross-entropy,&lt;br&gt;3 seeds, fresh test&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E75B6;fontColor=#1F3864;fontFamily=Arial;fontSize=10;align=center;verticalAlign=middle;strokeWidth=1.2;dashed=0;spacing=3;" vertex="1" parent="1"><mxGeometry x="271.0" y="34" width="114" height="90" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;4  CNN + DFE&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.6px&quot; color=&quot;#333333&quot;&gt;2 feedback taps,&lt;br&gt;9 channel conditions&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E75B6;fontColor=#1F3864;fontFamily=Arial;fontSize=10;align=center;verticalAlign=middle;strokeWidth=1.2;dashed=0;spacing=3;" vertex="1" parent="1"><mxGeometry x="402.5" y="34" width="114" height="90" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;5  Quantization&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.6px&quot; color=&quot;#333333&quot;&gt;QAT 3&amp;ndash;8 bit,&lt;br&gt;integer golden model&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E75B6;fontColor=#1F3864;fontFamily=Arial;fontSize=10;align=center;verticalAlign=middle;strokeWidth=1.2;dashed=0;spacing=3;" v