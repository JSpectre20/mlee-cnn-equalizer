y="34" width="112" height="82" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;2  Baselines&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:7.2px&quot; color=&quot;#333333&quot;&gt;FIR, Volterra,&lt;br&gt;FFE + DFE, MLSE&lt;br&gt;(closed-form fits)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E75B6;fontColor=#1F3864;fontFamily=Arial;fontSize=8.5;align=center;verticalAlign=middle;strokeWidth=1.2;dashed=0;spacing=3;" vertex="1" parent="1"><mxGeometry x="144" y="34" width="112" height="82" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;3  CNN search&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:7.2px&quot; color=&quot;#333333&quot;&gt;135 topologies&lt;br&gt;&amp;times; {MSE, cross-entropy}&lt;br&gt;3 seeds, fresh test&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E75B6;fontColor=#1F3864;fontFamily=Arial;fontSize=8.5;align=center;verticalAlign=middle;strokeWidth=1.2;dashed=0;spacing=3;" vertex="1" parent="1"><mxGeometry x="276" y="34" width="112" height="82" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;4  CNN + DFE&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:7.2px&quot; color=&quot;#333333&quot;&gt;2 feedback taps,&lt;br&gt;9 channel conditions&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E75B6;fontColor=#1F3864;fontFamily=Arial;fontSize=8.5;align=center;verticalAlign=middle;strokeWidth=1.2;dashed=0;spacing=3;" vertex="1" parent="1"><mxGeometry x="408" y="34" width="112" height="82" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;5  QAT + integer model&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:7.2px&quot; color=&quot;#333333&quot;&gt;3&amp;ndash;8 bit LSQ,&lt;br&gt;BN folding, requant&lt;br&gt;(acc+b)&amp;middot;M &amp;gt;&amp;gt; S&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E75B6;fontColor=#1F3864;fontFamily=Arial;fontSize=8.5;align=center;verticalAlign=middle;strokeWidth=1.2;dashed=0;spacing=3;" vertex="1" parent="1"><mxGeometry x="540" y="34" width="112" height="82" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;6  Export&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:7.2px&quot; color=&quot;#333333&quot;&gt;weights &amp;rarr; params.mem,&lt;br&gt;package, test vectors&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C55A11;fontColor=#7F3A0B;fontFamily=Arial;fontSize=8.5;align=center;verticalAlign=middle;strokeWidth=1.2;dashed=0;spacing=3;" vertex="1" parent="1"><mxGeometry x="12" y="184" width="112" height="82" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;7  Streaming RTL&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:7.2px&quot; color=&quot;#333333&quot;&gt;conv1d_stream &amp;times; L,&lt;br&gt;DSP packing,&lt;br&gt;DFE look-ahead&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C55A11;fontColor=#7F3A0B;fontFamily=Arial;fontSize=8.5;align=center;verticalAlign=middle;strokeWidth=1.2;dashed=0;spacing=3;" vertex="1" parent="1"><mxGeometry x="144" y="184" width="112" height="82" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;8  Verification&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:7.2px&quot; color=&quot;#333333&quot;&gt;unit + full model +&lt;br&gt;mutation +&lt;br&gt;gate-level netlists&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C55A11;fontColor=#7F3A0B;fontFamily=Arial;fontSize=8.5;align=center;verticalAlign=middle;strokeWidth=1.2;dashed=0;spacing=3;" vertex="1" parent="1"><mxGeometry x="276" y="184" width="112" height="82" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;9  Implementation&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:7.2px&quot; color=&quot;#333333&quot;&gt;timing closure r1&amp;ndash;r8c,&lt;br&gt;200 MHz, SAIF power&lt;/font&gt;" style="rounded=1;arc